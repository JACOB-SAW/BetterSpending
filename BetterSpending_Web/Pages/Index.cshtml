@page
@model IndexModel
@{
    ViewData["Title"] = "Home Page";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Better Spending - Browse Budget</title>
    <link rel="stylesheet" href="../css/Register.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <style>

        /* Add any custom styles here */
    </style>
</head>
<body class="bg-light text-center">
    <h1 class="text-success fw-bold my-4">Better Spending</h1>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4 mb-4">
                <!-- Added mb-4 for spacing -->
                <div class="card bg-success text-white p-4 shadow">
                    <h2 class="text-warning fw-bold">Budgets</h2>
                    <form class="mt-3" method="post">
                        @foreach (var budget in Model.Budgets)
                        {
                            <div class="w-100 text-center">
                                <a asp-page="/Budgets/BudgetView" asp-route-id="@budget.BudgetID" class="text-dark" style="font-size: 24px; text-decoration: none;">
                                    @budget.BudgetName
                                </a>
                                <hr />
                            </div>
                        }
                    </form>

                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                    </li>
                </div>
            </div>
        </div>
    </div>
    <footer class="mt-4">
        <p><a href="#" class="text-success text-decoration-none">About</a></p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>