@page
@model BetterSpending_Web.Pages.Categories.EditCategoryModel
@{
    ViewData["Title"] = "Edit Category";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BetterSpendingSignin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<body class="bg-light text-center">
    <h1 class="text-success fw-bold my-4">Better Spending</h1>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card bg-success text-white p-4 shadow">
                    <h2 class="text-warning fw-bold">Edit Category</h2>
                    <form class="mt-3" method="post">
                        <label asp-for="EditCat.CategoryName" class="form-label">Category Name</label>
                        <input asp-for="EditCat.CategoryName" type="text" class="form-control" style="background-color: white">
                        <span asp-validation-for="EditCat.CategoryName" class="text-danger"></span>

                        <label asp-for="EditCat.CategoryType" class="form-label">Category Type</label>
                        <input asp-for="EditCat.CategoryType" type="text" class="form-control" style="background-color: white">
                        <span asp-validation-for="EditCat.CategoryType" class="text-danger"></span>

                        <button type="submit" class="form-control btn btn-primary mt-3">Edit Category</button>
                    </form>
                    <p class="mt-3">

                    </p>
                    <a href="/" class="navigaton-link text-warning fw-bold text-decoration-none">Back to home page</a>
                </div>
            </div>
        </div>
    </div>
    <footer class="mt-4">
        <p><a href="#" class="text-success text-decoration-none">About</a></p>
        <p><a href="/Privacy" class="text-success text-decoration-none">© 2025 - BetterSpending - Privacy</a></p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
