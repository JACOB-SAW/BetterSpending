@page
@model BetterSpending_Web.Pages.Categories.CategoryListModel
@{
    ViewData["Title"] = "Category";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BetterSpendingSignin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<body class="bg-light text-center">
    <h1 class="text-success fw-bold my-4">Better Spending</h1>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card bg-success text-white p-4 shadow">
                    <h2 class="text-warning fw-bold">Category List</h2>
                    <form class="mt-3" method="post">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <label class="fw-bold text-decoration-none" style="cursor: pointer; color: black;" onclick="location.href='@Url.Page("/Categories/AddCategory")'">
                                <i class="bi bi-plus-circle me-2"></i>Add Category
                            </label>
                        </div>
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Category Name</th>
                                    <th>Category Type</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in Model.CatList)
                                {
                                    <tr>
                                        <td>@category.CategoryName</td>
                                        <td>@category.CategoryType</td>
                                        <td>
                                            <a asp-page="EditCategory" asp-route-id="@category.CategoryID" style="width: 100px" class="btn btn-primary "><i class="bi bi-pen-fill"></i>Edit</a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@category.CategoryID" style="display:inline;">
                                                <button onclick="return confirm(Are You Sure)" style="background-color: #ec1417; width: 100px" class="btn btn-danger mt-3" asp-route-id="@category.CategoryID" asp-route-handler="Delete"><i class="bi bi-trash3-fill"></i>Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </form>
                    <p class="mt-3"></p>
                    <a href="/" class="navigaton-link text-warning fw-bold text-decoration-none">Back to home page</a>
                </div>
            </div>
        </div>
    </div>
    <footer class="mt-4">
        <p><a href="#" class="text-success text-decoration-none">About</a></p>
        <p><a href="/Privacy" class="text-success text-decoration-none">© 2025 - BetterSpending - Privacy</a></p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
