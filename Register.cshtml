@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BetterSpendingHomePage</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
</head>
<body class="bg-light text-center">
    <h1 class="text-success fw-bold my-4">Better Spending</h1>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card bg-success text-white p-4 shadow">
                    <h2 class="text-warning fw-bold">Finances Made Easy</h2>
                    <form class="mt-3" action="/login" method="post">
                        <div class="text-danger" asp-validation-summary="All"></div>
                        <p><a href="#" class="text-white text-decoration-none" aria-label="Sign In">Sign In</a></p>
                        <p><a href="#" class="text-white text-decoration-none" aria-label="Create Account">Create Account</a></p>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <footer class="mt-4">
        <p><a href="#" class="text-success text-decoration-none" aria-label="About">About</a></p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
